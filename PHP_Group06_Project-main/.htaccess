# Directory listings are never wanted here: every directory that should be
# browsable has an index, and the rest were exposing their contents.
Options -Indexes

# Editor and OS leftovers should not be servable.
<FilesMatch "(^\.|\.(bak|sql|log|ini|md|dist|example\.php)$)">
    Require all denied
</FilesMatch>
# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>